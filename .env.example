# OpenAI API Key
# 1. https://platform.openai.com/ 접속
# 2. 계정 생성 또는 로그인
# 3. API Keys → Create new secret key
# 4. 아래에 키 붙여넣기
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Google Cloud Vision API Key (선택사항 - 더 정확한 OCR)
# 1. https://console.cloud.google.com/ 접속
# 2. 프로젝트 생성 → Vision API 활성화
# 3. API 키 발급
# 4. 아래에 키 붙여넣기
# 무료 크레딧: 월 1,000회
VITE_GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# Pexels API Key (레시피 이미지)
# 1. https://www.pexels.com/api/ 접속
# 2. 무료 계정 생성
# 3. API Key 발급
# 4. 아래에 키 붙여넣기
# 무료 크레딧: 월 20,000회
VITE_PEXELS_API_KEY=your-pexels-api-key-here
